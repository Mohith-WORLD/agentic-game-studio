# ==============================================================================
# Agentic Game Studio - Environment Configuration Template
# Copy this file to '.env' and populate with your credentials.
# NEVER commit your active '.env' file to version control.
# ==============================================================================

# Google Gemini API Key (Required for LLM Agents: Designer, Developer, QA)
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model Identifier
GEMINI_MODEL=gemini-2.5-flash

# Optional: ngrok Authtoken (Only required if exposing Pygbag web build via public tunnel)
# Obtain at: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Execution & Self-Repair Configuration
MAX_REPAIR_ATTEMPTS=2
SMOKE_TEST_FRAMES=60
EXECUTION_TIMEOUT_SECONDS=10
